<Window x:Class="FootballPrediction.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FMPS"
        WindowState="Maximized"
        Background="#050816">

    <Window.Resources>

        <Style TargetType="Button">

            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#1F2937"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,0"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter Property="Background" Value="#00FF88"/>
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="BorderBrush" Value="#00FF88"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </Window.Resources>

    <Grid>

        <!-- SIDEBAR -->
        <Border Width="260"
                Background="#0B1020"
                HorizontalAlignment="Left">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>

                <!-- LOGO -->
                <StackPanel Margin="25">

                    <TextBlock Text="⚽ FMPS"
                               Foreground="White"
                               FontSize="34"
                               FontWeight="Bold"/>

                    <TextBlock Text="Football Match Prediction System"
                               Foreground="#6B7280"
                               FontSize="14"
                               Margin="0,5,0,0"/>

                </StackPanel>

                <!-- MENU -->
                <StackPanel Grid.Row="1">

                    <!-- SECTION -->
                    <TextBlock Text="ГОЛОВНЕ МЕНЮ"
                               Foreground="#6B7280"
                               FontSize="13"
                               Margin="25,10,0,15"/>

                    <Button Content="🏠  Дашборд"
                            Margin="15,0,15,12"
                            Click="DashboardButton_Click"/>

                    <Button Content="📊  Прогнози"
                            Margin="15,0,15,12"
                            Click="PredictionsButton_Click"/>

                    <Button Content="🏆  Ліги"
                            Margin="15,0,15,25"
                            Click="LeaguesButton_Click"/>

                    <!-- SECTION -->
                    <TextBlock Text="АКАУНТ"
                               Foreground="#6B7280"
                               FontSize="13"
                               Margin="25,0,0,15"/>

                    <!-- PROFILE -->
                    <Button x:Name="ProfileButton"
                            Content="👤  Профіль"
                            Margin="15,0,15,12"
                            Click="ProfileButton_Click"/>

                    <!-- SETTINGS -->
                    <Button x:Name="SettingsButton"
                            Content="⚙  Налаштування"
                            Margin="15,0,15,12"
                            Click="SettingsButton_Click"/>

                    <!-- LOGIN -->
                    <Button x:Name="LoginButton"
                            Content="🔑  Вхід"
                            Margin="15,0,15,12"
                            Click="LoginButton_Click"
                            Visibility="Collapsed"/>

                    <!-- REGISTER -->
                    <Button x:Name="RegisterButton"
                            Content="📝  Реєстрація"
                            Margin="15,0,15,12"
                            Click="RegisterButton_Click"
                            Visibility="Collapsed"/>

                </StackPanel>

                <!-- USER CARD -->
                <Border Grid.Row="2"
                        Background="#111827"
                        CornerRadius="18"
                        Margin="15"
                        Padding="18"
                        BorderBrush="#1F2937"
                        BorderThickness="1">

                    <StackPanel>

                        <TextBlock Text="AI ANALYST"
                                   Foreground="#00FF88"
                                   FontSize="14"
                                   FontWeight="Bold"/>

                        <TextBlock Text="PRO EDITION"
                                   Foreground="White"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Margin="0,5,0,0"/>

                        <TextBlock Text="v2.1.0"
                                   Foreground="#6B7280"
                                   FontSize="13"
                                   Margin="0,5,0,0"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>

        <!-- CONTENT -->
        <Frame x:Name="MainFrame"
               Margin="260,0,0,0"
               NavigationUIVisibility="Hidden"
               Background="#050816"/>

    </Grid>

</Window>