<Page x:Class="FootballPrediction.Pages.PredictionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#050816">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="25">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>

            <!-- TOP -->
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,25">

                <!-- LEAGUE -->
                <ComboBox x:Name="LeagueComboBox"
          Width="300"
          Height="60"
          FontSize="22"
          Foreground="White"
          Background="#1F2937"
          BorderBrush="#00FF88"
          SelectionChanged="LeagueComboBox_SelectionChanged">

                    <ComboBoxItem Content="Premier League"/>
                    <ComboBoxItem Content="La Liga"/>
                    <ComboBoxItem Content="Bundesliga"/>
                    <ComboBoxItem Content="Champions League"/>
                    <ComboBoxItem Content="UPL"/>

                </ComboBox>

                <!-- BUTTON -->
                <Button Content="АНАЛІЗ"
                        Width="280"
                        Height="60"
                        Margin="25,0,0,0"
                        FontSize="24"
                        FontWeight="Bold"
                        Background="#00FF88"
                        Foreground="Black"
                        BorderThickness="0"
                        Click="Analyze_Click"/>

            </StackPanel>

            <!-- CONTENT -->
            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>

                <!-- MATCHES -->
                <Border Background="#111827"
                        CornerRadius="25"
                        BorderBrush="#00FF88"
                        BorderThickness="2"
                        Padding="25"
                        Margin="0,0,20,0">

                    <StackPanel>

                        <TextBlock Text="МАЙБУТНІ МАТЧІ"
                                   Foreground="White"
                                   FontSize="48"
                                   FontWeight="Bold"
                                   Margin="0,0,0,25"/>

                        <StackPanel x:Name="MatchesPanel"/>

                    </StackPanel>

                </Border>

                <!-- ANALYTICS -->
                <Border Grid.Column="1"
                        Background="#111827"
                        CornerRadius="25"
                        BorderBrush="#00FF88"
                        BorderThickness="2"
                        Padding="25">

                    <StackPanel>

                        <TextBlock Text="АНАЛІТИКА"
                                   Foreground="White"
                                   FontSize="42"
                                   FontWeight="Bold"
                                   Margin="0,0,0,25"/>

                        <!-- WINNER -->
                        <Border Background="#1F2937"
                                CornerRadius="15"
                                Padding="20"
                                Margin="0,0,0,15">

                            <StackPanel>

                                <TextBlock Text="MATCH WINNER"
                                           Foreground="#9CA3AF"
                                           FontSize="18"/>

                                <TextBlock x:Name="WinnerText"
           Text="-"
           Foreground="#00FF88"
           FontSize="28"
           FontWeight="Bold"
           TextWrapping="Wrap"
           MaxWidth="300"/>

                            </StackPanel>

                        </Border>

                        <!-- GOALS -->
                        <Border Background="#1F2937"
                                CornerRadius="15"
                                Padding="20"
                                Margin="0,0,0,15">

                            <StackPanel>

                                <TextBlock Text="TOTAL GOALS"
                                           Foreground="#9CA3AF"
                                           FontSize="18"/>

                                <TextBlock x:Name="GoalsText"
                                           Text="-"
                                           Foreground="#3B82F6"
                                           FontSize="34"
                                           FontWeight="Bold"/>

                            </StackPanel>

                        </Border>

                        <!-- CORNERS -->
                        <Border Background="#1F2937"
                                CornerRadius="15"
                                Padding="20"
                                Margin="0,0,0,15">

                            <StackPanel>

                                <TextBlock Text="CORNERS"
                                           Foreground="#9CA3AF"
                                           FontSize="18"/>

                                <TextBlock x:Name="CornersText"
                                           Text="-"
                                           Foreground="#F59E0B"
                                           FontSize="34"
                                           FontWeight="Bold"/>

                            </StackPanel>

                        </Border>

                        <!-- CARDS -->
                        <Border Background="#1F2937"
                                CornerRadius="15"
                                Padding="20"
                                Margin="0,0,0,15">

                            <StackPanel>

                                <TextBlock Text="YELLOW CARDS"
                                           Foreground="#9CA3AF"
                                           FontSize="18"/>

                                <TextBlock x:Name="CardsText"
                                           Text="-"
                                           Foreground="#EF4444"
                                           FontSize="34"
                                           FontWeight="Bold"/>

                            </StackPanel>

                        </Border>

                        <!-- BTTS -->
                        <Border Background="#1F2937"
                                CornerRadius="15"
                                Padding="20">

                            <StackPanel>

                                <TextBlock Text="BTTS"
                                           Foreground="#9CA3AF"
                                           FontSize="18"/>

                                <TextBlock x:Name="BttsText"
                                           Text="-"
                                           Foreground="#A855F7"
                                           FontSize="34"
                                           FontWeight="Bold"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </Border>

            </Grid>

        </Grid>

    </ScrollViewer>

</Page>
