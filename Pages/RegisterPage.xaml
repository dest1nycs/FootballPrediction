<Page x:Class="FootballPrediction.Pages.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#111827">

    <Grid>

        <Border Width="500"
                Padding="40"
                Background="#1F2937"
                CornerRadius="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <TextBlock Text="РЕЄСТРАЦІЯ"
                           Foreground="White"
                           FontSize="36"
                           FontWeight="Bold"
                           Margin="0,0,0,30"
                           HorizontalAlignment="Center"/>

                <!-- USERNAME -->

                <TextBlock Text="Ім'я користувача"
                           Foreground="#9CA3AF"
                           FontSize="18"/>

                <TextBox x:Name="UsernameTextBox"
                         Height="50"
                         FontSize="20"
                         Margin="0,10,0,20"
                         Background="#111827"
                         Foreground="White"
                         BorderBrush="#00FF88"/>

                <!-- PASSWORD -->

                <TextBlock Text="Пароль"
                           Foreground="#9CA3AF"
                           FontSize="18"/>

                <PasswordBox x:Name="PasswordBox"
                             Height="50"
                             FontSize="20"
                             Margin="0,10,0,20"
                             Background="#111827"
                             Foreground="White"
                             BorderBrush="#00FF88"/>

                <!-- ERROR -->

                <TextBlock x:Name="ErrorText"
                           Foreground="#EF4444"
                           FontSize="16"
                           Margin="0,0,0,20"
                           TextWrapping="Wrap"/>

                <!-- BUTTON -->

                <Button Content="СТВОРИТИ АКАУНТ"
                        Height="55"
                        FontSize="20"
                        FontWeight="Bold"
                        Background="#00FF88"
                        Foreground="Black"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Register_Click"/>

                <!-- LOGIN -->

                <Button Content="У мене вже є акаунт"
                        Margin="0,20,0,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#9CA3AF"
                        FontSize="16"
                        Cursor="Hand"
                        Click="GoToLogin_Click"/>

            </StackPanel>

        </Border>

    </Grid>
</Page>