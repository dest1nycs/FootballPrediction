<Page x:Class="FootballPrediction.Pages.LeaguesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#050816">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="35">

            <!-- TITLE -->

            <TextBlock Text="ЛІГИ"
                       Foreground="White"
                       FontSize="56"
                       FontWeight="Bold"/>

            

            <!-- GRID -->

            <UniformGrid Columns="2">

                <!-- PREMIER LEAGUE -->

                <Border Background="#111827"
                        CornerRadius="30"
                        Padding="30"
                        Margin="0,0,25,25">

                    <StackPanel>

                        <TextBlock Text="🏆 Premier League"
                                   Foreground="White"
                                   FontSize="28"
                                   FontWeight="Bold"/>

                        <TextBlock Text="England"
                                   Foreground="#6B7280"
                                   FontSize="16"
                                   Margin="0,10,0,20"/>

                        <DataGrid x:Name="PremierLeagueGrid"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column"
                                  Background="#111827"
                                  Foreground="White"
                                  BorderThickness="0"
                                  RowBackground="#1F2937"
                                  AlternatingRowBackground="#111827"
                                  Height="260">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="#"
                                                    Binding="{Binding Position}"
                                                    Width="50"/>

                                <DataGridTextColumn Header="Команда"
                                                    Binding="{Binding Team}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="PTS"
                                                    Binding="{Binding Points}"
                                                    Width="70"/>

                            </DataGrid.Columns>

                        </DataGrid>

                        <Button Content="Показати всю таблицю"
                                Margin="0,15,0,0"
                                Background="#00FF88"
                                Foreground="Black"
                                Height="45"
                                FontWeight="Bold"
                                Click="PremierLeagueExpand_Click"/>

                    </StackPanel>

                </Border>

                <!-- LA LIGA -->

                <Border Background="#111827"
                        CornerRadius="30"
                        Padding="30"
                        Margin="0,0,0,25">

                    <StackPanel>

                        <TextBlock Text="⚽ La Liga"
                                   Foreground="White"
                                   FontSize="28"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Spain"
                                   Foreground="#6B7280"
                                   FontSize="16"
                                   Margin="0,10,0,20"/>

                        <DataGrid x:Name="LaLigaGrid"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column"
                                  Background="#111827"
                                  Foreground="White"
                                  BorderThickness="0"
                                  RowBackground="#1F2937"
                                  AlternatingRowBackground="#111827"
                                  Height="260">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="#"
                                                    Binding="{Binding Position}"
                                                    Width="50"/>

                                <DataGridTextColumn Header="Команда"
                                                    Binding="{Binding Team}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="PTS"
                                                    Binding="{Binding Points}"
                                                    Width="70"/>

                            </DataGrid.Columns>

                        </DataGrid>

                        <Button Content="Показати всю таблицю"
                                Margin="0,15,0,0"
                                Background="#00FF88"
                                Foreground="Black"
                                Height="45"
                                FontWeight="Bold"
                                Click="LaLigaExpand_Click"/>

                    </StackPanel>

                </Border>

                <!-- CHAMPIONS LEAGUE -->

                <Border Background="#111827"
                        CornerRadius="30"
                        Padding="30"
                        Margin="0,0,25,25">

                    <StackPanel>

                        <TextBlock Text="⭐ Champions League"
                                   Foreground="White"
                                   FontSize="28"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Europe"
                                   Foreground="#6B7280"
                                   FontSize="16"
                                   Margin="0,10,0,20"/>

                        <DataGrid x:Name="ChampionsLeagueGrid"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column"
                                  Background="#111827"
                                  Foreground="White"
                                  BorderThickness="0"
                                  RowBackground="#1F2937"
                                  AlternatingRowBackground="#111827"
                                  Height="260">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="#"
                                                    Binding="{Binding Position}"
                                                    Width="50"/>

                                <DataGridTextColumn Header="Команда"
                                                    Binding="{Binding Team}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="PTS"
                                                    Binding="{Binding Points}"
                                                    Width="70"/>

                            </DataGrid.Columns>

                        </DataGrid>

                        <Button Content="Показати всю таблицю"
                                Margin="0,15,0,0"
                                Background="#00FF88"
                                Foreground="Black"
                                Height="45"
                                FontWeight="Bold"
                                Click="ChampionsLeagueExpand_Click"/>

                    </StackPanel>

                </Border>

                <!-- BUNDESLIGA -->

                <Border Background="#111827"
                        CornerRadius="30"
                        Padding="30"
                        Margin="0,0,0,25">

                    <StackPanel>

                        <TextBlock Text="🔥 Bundesliga"
                                   Foreground="White"
                                   FontSize="28"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Germany"
                                   Foreground="#6B7280"
                                   FontSize="16"
                                   Margin="0,10,0,20"/>

                        <DataGrid x:Name="BundesligaGrid"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column"
                                  Background="#111827"
                                  Foreground="White"
                                  BorderThickness="0"
                                  RowBackground="#1F2937"
                                  AlternatingRowBackground="#111827"
                                  Height="260">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="#"
                                                    Binding="{Binding Position}"
                                                    Width="50"/>

                                <DataGridTextColumn Header="Команда"
                                                    Binding="{Binding Team}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="PTS"
                                                    Binding="{Binding Points}"
                                                    Width="70"/>

                            </DataGrid.Columns>

                        </DataGrid>

                        <Button Content="Показати всю таблицю"
                                Margin="0,15,0,0"
                                Background="#00FF88"
                                Foreground="Black"
                                Height="45"
                                FontWeight="Bold"
                                Click="BundesligaExpand_Click"/>

                    </StackPanel>

                </Border>

                <!-- UPL -->

                <Border Background="#111827"
                        CornerRadius="30"
                        Padding="30"
                        Margin="0,0,25,25">

                    <StackPanel>

                        <TextBlock Text="🇺🇦 PPL"
                                   Foreground="White"
                                   FontSize="28"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Ukraine"
                                   Foreground="#6B7280"
                                   FontSize="16"
                                   Margin="0,10,0,20"/>

                        <DataGrid x:Name="UPLGrid"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column"
                                  Background="#111827"
                                  Foreground="White"
                                  BorderThickness="0"
                                  RowBackground="#1F2937"
                                  AlternatingRowBackground="#111827"
                                  Height="260">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="#"
                                                    Binding="{Binding Position}"
                                                    Width="50"/>

                                <DataGridTextColumn Header="Команда"
                                                    Binding="{Binding Team}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="PTS"
                                                    Binding="{Binding Points}"
                                                    Width="70"/>

                            </DataGrid.Columns>

                        </DataGrid>

                        <Button Content="Показати всю таблицю"
                                Margin="0,15,0,0"
                                Background="#00FF88"
                                Foreground="Black"
                                Height="45"
                                FontWeight="Bold"
                                Click="UPLExpand_Click"/>

                    </StackPanel>

                </Border>

            </UniformGrid>

        </StackPanel>

    </ScrollViewer>

</Page>
