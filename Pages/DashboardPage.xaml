<Page x:Class="FootballPrediction.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#050816">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="35">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>

                </Grid.ColumnDefinitions>

                <!-- TITLE -->
                <StackPanel>

                    <TextBlock Text="ДАШБОРД"
                               Foreground="White"
                               FontSize="52"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="DashboardInfoText"
                               Foreground="#9CA3AF"
                               FontSize="16"/>

                </StackPanel>

                <!-- NEW -->
                <Button Grid.Column="1"
                        Content="+ Новий прогноз"
                        Background="#00FF88"
                        Foreground="Black"
                        BorderThickness="0"
                        FontSize="16"
                        FontWeight="Bold"
                        Height="52"
                        Click="NewPrediction_Click"/>

            </Grid>

            <!-- TOP CARDS -->
            <Grid Grid.Row="1"
                  Margin="0,35,0,35">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>

                </Grid.ColumnDefinitions>

                <!-- CARD 1 -->
                <Border Grid.Column="0"
                        Background="#111827"
                        CornerRadius="22"
                        BorderBrush="#00FF88"
                        BorderThickness="2"
                        Margin="0,0,15,0"
                        Padding="25">

                    <StackPanel>

                        <TextBlock Text="ТОЧНІСТЬ МОДЕЛІ"
                                   Foreground="#6B7280"
                                   FontSize="15"/>

                        <TextBlock Text="71.4%"
                                   Foreground="#00FF88"
                                   FontSize="54"
                                   FontWeight="Bold"
                                   Margin="0,10,0,0"/>

                        <TextBlock Text="↑ +2.3% за тиждень"
                                   Foreground="#00FF88"
                                   FontSize="18"/>

                    </StackPanel>

                </Border>

                <!-- CARD 2 -->
                <Border Grid.Column="1"
                        Background="#111827"
                        CornerRadius="22"
                        BorderBrush="#3B82F6"
                        BorderThickness="2"
                        Margin="0,0,15,0"
                        Padding="25">

                    <StackPanel>

                        <TextBlock Text="ПРОГНОЗІВ ЗА СЕСІЮ"
                                   Foreground="#6B7280"
                                   FontSize="15"/>

                        <TextBlock x:Name="PredictionsTodayText"
                                   Text="0"
                                   Foreground="#3B82F6"
                                   FontSize="54"
                                   FontWeight="Bold"
                                   Margin="0,10,0,0"/>

                        <TextBlock Text="оновлюється онлайн"
                                   Foreground="#00FF88"
                                   FontSize="18"/>

                    </StackPanel>

                </Border>

                <!-- CARD 3 -->
                <Border Grid.Column="2"
                        Background="#111827"
                        CornerRadius="22"
                        BorderBrush="#EAB308"
                        BorderThickness="2"
                        Margin="0,0,15,0"
                        Padding="25">

                    <StackPanel>

                        <TextBlock Text="АКТИВНИХ ЛІГ"
                                   Foreground="#6B7280"
                                   FontSize="15"/>

                        <TextBlock Text="5"
                                   Foreground="#EAB308"
                                   FontSize="54"
                                   FontWeight="Bold"
                                   Margin="0,10,0,0"/>

                        <TextBlock Text="АПЛ · UCL · Ла Ліга"
                                   Foreground="#9CA3AF"
                                   FontSize="18"/>

                    </StackPanel>

                </Border>

                <!-- CARD 4 -->
                <Border Grid.Column="3"
                        Background="#111827"
                        CornerRadius="22"
                        BorderBrush="#F43F5E"
                        BorderThickness="2"
                        Padding="25">

                    <StackPanel>

                        <TextBlock Text="LIVE МАТЧІВ"
                                   Foreground="#6B7280"
                                   FontSize="15"/>

                        <TextBlock x:Name="LiveMatchesText"
                                   Text="0"
                                   Foreground="#F43F5E"
                                   FontSize="54"
                                   FontWeight="Bold"
                                   Margin="0,10,0,0"/>

                        <TextBlock Text="Оновлення в реальному часі"
                                   Foreground="#9CA3AF"
                                   FontSize="18"/>

                    </StackPanel>

                </Border>

            </Grid>

            <!-- MAIN CONTENT -->
            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>

                <!-- PREDICTIONS -->
                <Border Background="#111827"
                        CornerRadius="25"
                        Padding="25"
                        Margin="0,0,20,0">

                    <StackPanel>

                        <!-- TITLE -->
                        <Grid Margin="0,0,0,25">

                            <TextBlock Text="ПРОГНОЗИ НА СЬОГОДНІ"
                                       Foreground="White"
                                       FontSize="36"
                                       FontWeight="Bold"/>

                        </Grid>

                        <!-- MATCH CARD -->
                        <Border Background="#161F35"
                                CornerRadius="20"
                                Padding="25"
                                Margin="0,0,0,20">

                            <StackPanel>

                                <!-- LEAGUE -->
                                <Grid Margin="0,0,0,15">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="● Онлайн дані football-data API"
                                               Foreground="#6B7280"
                                               FontSize="15"/>

                                    <Border Grid.Column="1"
                                            Background="#123B2A"
                                            CornerRadius="8"
                                            Padding="10,5"
                                            Margin="10,0">

                                        <TextBlock Text="LIVE API"
                                                   Foreground="#00FF88"
                                                   FontWeight="Bold"/>

                                    </Border>

                                    <TextBlock Grid.Column="2"
                                               Text="ONLINE"
                                               Foreground="#9CA3AF"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0"/>

                                </Grid>

                                <!-- CONTENT -->
                                <StackPanel>

                                    <TextBlock Text="Система автоматично отримує актуальні матчі та статистику команд"
                                               Foreground="White"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Text="Прогнози формуються на основі реальних standings, голів, перемог та форми команд."
                                               Foreground="#9CA3AF"
                                               FontSize="18"
                                               Margin="0,20,0,0"
                                               TextWrapping="Wrap"/>

                                </StackPanel>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </Border>

                <!-- ACCURACY -->
                <Border Grid.Column="1"
                        Background="#111827"
                        CornerRadius="25"
                        Padding="25">

                    <StackPanel>

                        <Grid Margin="0,0,0,30">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>

                            <TextBlock Text="ТОЧНІСТЬ МОДЕЛІ"
                                       Foreground="White"
                                       FontSize="34"
                                       FontWeight="Bold"/>

                            <Border Grid.Column="1"
                                    Background="#123B2A"
                                    CornerRadius="10"
                                    Padding="12,6">

                                <TextBlock Text="ЦЬОГО МІСЯЦЯ"
                                           Foreground="#00FF88"
                                           FontWeight="Bold"/>

                            </Border>

                        </Grid>

                        <!-- CIRCLE -->
                        <Grid HorizontalAlignment="Center"
                              Margin="0,30">

                            <Ellipse Width="220"
                                     Height="220"
                                     Stroke="#1F2937"
                                     StrokeThickness="18"/>

                            <Ellipse Width="220"
                                     Height="220"
                                     Stroke="#00FF88"
                                     StrokeThickness="18"
                                     StrokeDashArray="8 4"/>

                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center">

                                <TextBlock Text="71%"
                                           Foreground="#00FF88"
                                           FontSize="56"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="ACCURACY"
                                           Foreground="#6B7280"
                                           FontSize="18"
                                           HorizontalAlignment="Center"/>

                            </StackPanel>

                        </Grid>

                        <!-- STATS -->
                        <Grid Margin="0,40,0,0">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>

                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock Text="48"
                                           Foreground="#00FF88"
                                           FontSize="42"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="ТОЧНИХ"
                                           Foreground="#6B7280"
                                           HorizontalAlignment="Center"/>

                            </StackPanel>

                            <StackPanel Grid.Column="1">

                                <TextBlock Text="12"
                                           Foreground="#EAB308"
                                           FontSize="42"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="НІЧИЯ"
                                           Foreground="#6B7280"
                                           HorizontalAlignment="Center"/>

                            </StackPanel>

                            <StackPanel Grid.Column="2">

                                <TextBlock Text="7"
                                           Foreground="#F43F5E"
                                           FontSize="42"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="ПРОМАХ"
                                           Foreground="#6B7280"
                                           HorizontalAlignment="Center"/>

                            </StackPanel>

                        </Grid>

                    </StackPanel>

                </Border>

            </Grid>

        </Grid>

    </ScrollViewer>

</Page>
