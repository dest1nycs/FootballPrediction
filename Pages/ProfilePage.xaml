<Page x:Class="FootballPrediction.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#050816">

    <Grid Margin="35">

        <StackPanel>

            <TextBlock Text="ПРОФІЛЬ"
                       Foreground="White"
                       FontSize="48"
                       FontWeight="Bold"/>

            <TextBlock Text="User analytics profile"
                       Foreground="#9CA3AF"
                       FontSize="16"
                       Margin="0,0,0,30"/>

            <Border Background="#111827"
                    CornerRadius="25"
                    Padding="35"
                    Width="500">

                <StackPanel>

                    <TextBlock x:Name="UsernameText"
                               Foreground="White"
                               FontSize="36"
                               FontWeight="Bold"/>

                    <TextBlock Text="Football Analyst"
                               Foreground="#00FF88"
                               FontSize="18"
                               Margin="0,10,0,30"/>

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition/>
                            <ColumnDefinition/>

                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock x:Name="TotalPredictionsText"
                                       Foreground="#00FF88"
                                       FontSize="42"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Прогнозів"
                                       Foreground="#6B7280"/>

                        </StackPanel>

                        <StackPanel Grid.Column="1">

                            <TextBlock x:Name="TodayPredictionsText"
                                       Foreground="#3B82F6"
                                       FontSize="42"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Сьогодні"
                                       Foreground="#6B7280"/>

                        </StackPanel>

                    </Grid>
                    <Button Content="ВИЙТИ З АКАУНТУ"
        Height="55"
        FontSize="18"
        FontWeight="Bold"
        Background="#EF4444"
        Foreground="White"
        BorderThickness="0"
        Margin="0,35,0,0"
        Cursor="Hand"
        Click="Logout_Click"/>
                </StackPanel>

            </Border>

        </StackPanel>

    </Grid>

</Page>
